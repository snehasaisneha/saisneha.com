---
import { SITE } from "@/config";
import { createHash } from "node:crypto";
import faviconSource from "../../public/favicon.svg?raw";
import "@/styles/minimal.css";
type Props = {
  title?: string;
  description?: string;
  author?: string;
  profile?: string;
  ogImage?: string;
  canonicalURL?: string | URL;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  article?: boolean;
};
const {
  title = SITE.title,
  description = SITE.desc,
  author = SITE.author,
  ogImage = "/og.png",
  canonicalURL,
  pubDatetime,
  modDatetime,
  article = false,
} = Astro.props;
const canonical = canonicalURL ?? new URL(Astro.url.pathname, SITE.website);
const social = new URL(ogImage, SITE.website);
// Temporary previews must serve their own images, not the deployed site's.
if (
  import.meta.env.PUBLIC_PREVIEW_ORIGIN &&
  social.origin === new URL(SITE.website).origin
) {
  const preview = new URL(import.meta.env.PUBLIC_PREVIEW_ORIGIN);
  social.protocol = preview.protocol;
  social.host = preview.host;
}
if (ogImage === "/og.png") {
  social.searchParams.set(
    "v",
    createHash("sha256")
      .update(`${SITE.title}\n${SITE.desc}`)
      .digest("hex")
      .slice(0, 12)
  );
}
const iconVersion = createHash("sha256")
  .update(faviconSource)
  .digest("hex")
  .slice(0, 12);
const structured = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: social.href,
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime ? { dateModified: modDatetime.toISOString() } : {}),
      author: { "@type": "Person", name: author },
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{title}</title><meta name="description" content={description} /><meta
      name="author"
      content={author}
    />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href={`/favicon.ico?v=${iconVersion}`}
      sizes="16x16 32x32 48x48"
    />
    <link
      rel="icon"
      href={`/favicon-32.png?v=${iconVersion}`}
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="icon"
      href={`/favicon.svg?v=${iconVersion}`}
      type="image/svg+xml"
      sizes="any"
    />
    <link
      rel="apple-touch-icon"
      href={`/apple-touch-icon.png?v=${iconVersion}`}
      sizes="180x180"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={social}
    /><meta property="og:type" content={pubDatetime ? "article" : "website"} />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:image"
      content={social}
    />
    {
      article && (
        <link
          rel="preload"
          href="/fonts/eb-garamond/eb-garamond-latin-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    {
      structured && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structured).replaceAll("<", "\\u003c")}
        />
      )
    }
  </head><body
    ><a class="skip-link" href="#main-content">Skip to content</a><slot /></body
  >
</html>
