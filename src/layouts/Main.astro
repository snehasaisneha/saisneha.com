---
type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  titleTransition?: string;
};
const { pageTitle, pageDesc } = Astro.props;
---

<main id="main-content" class="shell">
  <h1>{Array.isArray(pageTitle) ? pageTitle.join(" ") : pageTitle}</h1>{
    pageDesc && <p class="muted">{pageDesc}</p>
  }<slot />
</main>
