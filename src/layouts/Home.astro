---
import Layout from "./Layout.astro";
import { Content as Introduction } from "@/content/home-introduction.md";
import { Content as PostsIntroduction } from "@/content/home-posts-introduction.md";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Timeline from "@/components/Timeline.astro";
import PageNav from "@/components/PageNav.astro";
import { homeWriting, HOME_SIZE } from "@/utils/writing";
import { SITE } from "@/config";
type Props = { page?: number };
const { page = 1 } = Astro.props;
const posts = await homeWriting();
const total = Math.max(1, Math.ceil(posts.length / HOME_SIZE));
---

<Layout title={page === 1 ? SITE.title : `Page ${page} | ${SITE.title}`}
  ><Header /><main id="main-content" class="shell">
    <h1 class="sr-only">Writing</h1>
    {
      page === 1 && (
        <>
          <h2>About Me</h2>
          <div class="prose home-introduction">
            <Introduction />
          </div>
          <hr class="home-divider" />
        </>
      )
    }
    <h2>Posts</h2>
    {
      page === 1 && (
        <div class="prose">
          <PostsIntroduction />
        </div>
      )
    }
    <Timeline
      posts={posts.slice((page - 1) * HOME_SIZE, page * HOME_SIZE)}
    /><PageNav current={page} {total} />
  </main><Footer /></Layout
>
