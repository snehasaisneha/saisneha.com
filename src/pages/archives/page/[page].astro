---
import Archive from "@/layouts/Archive.astro";
import { writing, ARCHIVE_SIZE } from "@/utils/writing";
export async function getStaticPaths() {
  const posts = await writing();
  return Array.from(
    { length: Math.max(0, Math.ceil(posts.length / ARCHIVE_SIZE) - 1) },
    (_, i) => ({ params: { page: String(i + 2) }, props: { page: i + 2 } })
  );
}
const { page } = Astro.props;
---

<Archive {page} />
