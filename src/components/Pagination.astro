---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
type Props = { page: Page<CollectionEntry<"blog">> };
const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="page-nav shell" aria-label="Post pages">
      <>
        <div>{page.url.prev && <a href={page.url.prev}>← Newer posts</a>}</div>
        <span>
          Page {page.currentPage} of {page.lastPage}
        </span>
        <div>{page.url.next && <a href={page.url.next}>Older posts →</a>}</div>
      </>
    </nav>
  )
}
