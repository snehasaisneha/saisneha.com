---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
type Props = CollectionEntry<"blog"> & { variant?: string };
const { id, filePath, data } = Astro.props;
---

<li class="post-card">
  <h2>
    <a
      data-astro-prefetch
      href={getPath(id, filePath, true, data.pubDatetime) + "/"}>{data.title}</a
    >
  </h2><time class="muted" datetime={data.pubDatetime.toISOString()}
    >{
      data.pubDatetime.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
        timeZone: "Asia/Kolkata",
      })
    }</time
  >{data.subtitle && <p class="post-subtitle">{data.subtitle}</p>}
</li>
