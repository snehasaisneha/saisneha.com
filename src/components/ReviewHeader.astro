---
import type { CollectionEntry } from "astro:content";
type Data = CollectionEntry<"blog">["data"];
type Props = {
  film: NonNullable<Data["film"]>;
  originalPublication?: Data["originalPublication"];
};
const { film, originalPublication } = Astro.props;
const stars =
  film.rating === undefined
    ? ""
    : "★".repeat(Math.floor(film.rating)) + (film.rating % 1 ? "½" : "");
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<aside class="review-header" aria-label="Review details">
  <p class="film-details">
    <span><strong>{film.title}</strong> ({film.year})</span>
    {
      film.rating !== undefined && (
        <span class="film-rating" aria-label={`${film.rating} out of 5 stars`}>
          <span aria-hidden="true">{stars}</span>
        </span>
      )
    }
  </p>
  {
    film.watchedOn && (
      <p>
        Watched{" "}
        <time datetime={film.watchedOn}>
          {formatDate(new Date(film.watchedOn + "T00:00:00Z"))}
        </time>
      </p>
    )
  }
  {
    originalPublication && (
      <p class="review-source">
        <span>{`Originally posted on ${originalPublication.platform}.`}</span>{" "}
        <a
          href={originalPublication.url}
          target="_blank"
          rel="noopener noreferrer"
        >View Original</a>{"."}
        {originalPublication.date && (
          <>
            {" "}
            Originally published{" "}
            <time datetime={originalPublication.date.toISOString()}>
              {formatDate(originalPublication.date)}
            </time>
            .
          </>
        )}
      </p>
    )
  }
  {
    film.spoilers && (
      <p class="review-spoilers">This review may contain spoilers.</p>
    )
  }
</aside>
<style>
  .review-header {
    border-block: 1px solid #d8d4cc;
    padding-block: 16px;
    margin: 0 0 30px;
    font:
      13px/1.7 Verdana,
      sans-serif;
    color: #555;
  }
  .review-header p {
    margin: 6px 0;
  }
  .film-details {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    color: #222;
  }
  .film-rating {
    font-size: 20px;
    letter-spacing: 1px;
    line-height: 1.3;
  }
  .review-spoilers {
    font-style: italic;
  }
  @media (max-width: 767px) {
    .review-header {
      font-size: 12px;
      margin-bottom: 24px;
      padding-block: 12px;
    }
  }
</style>
